# Agent sandbox image: Claude Code + git + node. Runs as uid 1000 (matches the host user so bind-mounted
# workspaces stay writable). Build: docker build -f Dockerfile.agent -t agent-factory-agent:latest .
FROM node:22-bookworm
RUN npm install -g @anthropic-ai/claude-code @openai/codex && npm cache clean --force
USER node
WORKDIR /work
